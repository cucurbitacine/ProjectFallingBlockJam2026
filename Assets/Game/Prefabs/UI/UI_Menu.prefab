      m_Calls: []
  m_text: "The secret to long spaghetti lies in the cooking pace! Don\u2019t stay at the same height for too long. If you don\u2019t reach new heights, your spaghetti will eventually snap!\n\n<color=green>Climb higher</color> to <color=green>gain more time</color> to stretch your spaghetti!\n\nAs a last resort, you can <color=yellow>complete an entire row</color>. It will disappear and <color=yellow>fully restore your time</color>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8a89fa14b10d46a99122fd4f73fca9a2, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: a00013af81304728b2be1f4309ee2433, type: 2}
